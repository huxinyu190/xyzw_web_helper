# Keep maintained source stable across Windows and WSL checkouts.
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.scss text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Windows 7 运行包的脚本必须保持 CRLF，否则 cmd.exe 解析可能异常
*.bat text eol=crlf
*.vbs text eol=crlf
deploy/win7/README.txt -text
